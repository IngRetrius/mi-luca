{
  "name": "mi-luca",
  "private": true,
  "description": "MiLuca: plataforma de planificación financiera personal (monorepo)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@miluca/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @miluca/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  }
}
