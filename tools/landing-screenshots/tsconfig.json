{
  "extends": "@miluca/config/tsconfig/library.json",
  "compilerOptions": {
    // DOM: las funciones que se pasan a page.evaluate corren en el navegador.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // Node ejecuta los .ts directamente (sin compilar): solo sintaxis que se puede borrar.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
