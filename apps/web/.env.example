# Copia este archivo como .env.local y completa los valores.
# La URL del proyecto no es secreta. Las claves están en Supabase > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://ryhvshstjuuasgwcepua.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (sb_secret_...): salta RLS. Nunca con prefijo NEXT_PUBLIC_ ni en el repositorio.
# Se usa para crear la cuenta del cliente desde una invitación (ADR 0009).
SUPABASE_SECRET_KEY=

# Solo servidor: clave de la API de Anthropic para el asistente del asesor (ADR 0012).
# Sin ella, el asistente avisa que no está configurado. Nunca con prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
