# Copia este archivo como supabase/.env y completa los valores. La CLI de Supabase lo lee para
# resolver los env(...) de config.toml, tanto en `supabase start` como en `supabase config push`.
# Nunca subas supabase/.env al repositorio.

# Secreto del cliente de OAuth de Google (Google Cloud > Google Auth Platform > Clients > MiLuca).
# Google lo muestra una sola vez al crear el cliente; si se pierde, se crea un secreto nuevo.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Contraseña de aplicación de Google para enviar los correos de Auth desde retrius2001@gmail.com
# (config.toml, [remotes.production.auth.email.smtp]). Se crea en la cuenta de Google > Seguridad >
# Contraseñas de aplicación, con la verificación en dos pasos activa. Son 16 letras; va sin espacios.
SUPABASE_AUTH_SMTP_PASS=
